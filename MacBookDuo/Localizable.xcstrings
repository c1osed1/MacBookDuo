      }
    },
    "Barely open" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Чуть открыта" } }
      }
    },
    "Begins at %.0f°" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Начинается с %.0f°" } }
      }
    },
    "Blur" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Размытие" } }
      }
    },
    "Blur radius at the far edge." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Радиус размытия на дальнем крае." } }
      }
    },
    "Blur spread" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ширина размытия" } }
      }
    },
    "Close the lid. The screen recedes in 3D — Glass, Duo+, or Frost, driven by the real hinge." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закройте крышку. Экран уходит в 3D — Glass, Duo+ или Frost, по настоящему шарниру." } }
      }
    },
    "Close this window to leave the Dock. MacBook Duo stays in the menu bar and the lid fold keeps running." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закройте окно — иконка уйдёт из Dock. MacBook Duo останется в меню-баре, складка крышки продолжит работать." } }
      }
    },
    "Closed" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закрыта" } }
      }
    },
