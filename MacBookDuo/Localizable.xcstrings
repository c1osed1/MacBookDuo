    },
    "Fixed plane: the picture holds its angle while the lid closes." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Фиксированная плоскость: картинка держит угол, пока крышка закрывается." } }
